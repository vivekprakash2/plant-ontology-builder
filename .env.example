# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real tokens.
#
# Databricks Model Serving (OpenAI-compatible endpoint), used to polish the
# deterministic agent answers into more natural prose. See
# ontology_builder/llm_provider.py for how these are read.

# Your Databricks workspace hostname (bare hostname or full URL, either works), e.g.:
DATABRICKS_HOST=

# The name of your Claude Opus serving endpoint in Databricks.
LLM_MODEL=databricks-claude-opus-4-8

# Your Databricks personal access token. NEVER share/paste this in chat --
# only put it directly in this local .env file.
DATABRICKS_TOKEN=

# Optional: name of a Databricks embedding-model serving endpoint (e.g. a
# BGE/E5 endpoint -- NOT the same endpoint as the chat model above), used
# by Stage 1 entity resolution for AI-based name-similarity scoring
# instead of the deterministic difflib fallback. If unset, or if the
# endpoint isn't reachable/doesn't exist, resolution automatically and
# silently falls back to the offline provider -- this is optional, not
# required for the pipeline to work.
EMBEDDING_MODEL=

